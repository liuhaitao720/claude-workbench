{
  "name": "claude-workbench",
  "version": "1.0.3",
  "description": "Claude Code 多项目多任务终端工作台",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "smoke": "node scripts/smoke/run-smoke.mjs",
    "smoke:recovery": "node scripts/smoke/run-recovery.mjs",
    "pack": "electron-builder --dir",
    "pack:full": "npm run build && node scripts/package-verify/run-full-pack.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:portable": "node scripts/package-verify/run-portable-pack.mjs",
    "pack:zip": "node scripts/package-verify/run-zip-pack.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "author": "Liu Haitao"
}
